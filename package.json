{
  "name": "forgeboard",
  "private": true,
  "version": "0.0.1",
  "description": "Local cockpit for AI coding agents — Lead, Builder and Reviewer working together on your repo.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @forgeboard/server dev\" \"pnpm --filter @forgeboard/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^5.9.3"
  }
}
